{
  "name": "watch-buddy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/game --noEmit && tsc -p apps/sim --noEmit && tsc -p apps/web --noEmit",
    "sim": "pnpm --filter @pulseling/sim sim",
    "web": "pnpm --filter @pulseling/web dev"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
